# Environment (prod or stage)
APP_ENV=prod

# Production Database
PROD_DB_HOST=ondc-prod-prod-open-data-db.cuvt1j5xqeya.ap-south-1.rds.amazonaws.com
PROD_DB_PORT=5432
PROD_DB_DATABASE=open_data_prod
PROD_DB_USER=ondc-open-data-webapp-user
PROD_DB_PASSWORD=aKNUkdVwjt9lHkmJBGc

# Staging Database
STAGE_DB_HOST=ondc-prod-prod-open-data-db.cuvt1j5xqeya.ap-south-1.rds.amazonaws.com
STAGE_DB_PORT=5432
STAGE_DB_DATABASE=open_data_stage
STAGE_DB_USER=ondc-open-data-webapp-staging-user
STAGE_DB_PASSWORD=ss4XN8U10GeU98

# Redis (set REDIS_ENABLED=false to disable caching entirely)
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# MCP Server
TRANSPORT=stdio
MAX_QUERY_ROWS=1000
QUERY_TIMEOUT_SECONDS=600

# Logging
LOG_LEVEL=INFO
AUDIT_LOG_PATH=logs/audit.jsonl

# Rate limiting
RATE_LIMIT_PER_MINUTE=30

# Security monitoring
SECURITY_MONITOR_ENABLED=true
SECURITY_ALERT_LOG_PATH=logs/security_alerts.jsonl
