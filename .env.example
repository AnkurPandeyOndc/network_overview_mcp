# PostgreSQL (individual vars — DATABASE_URL is auto-built from these)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ondc_analytics
DATABASE_USER=ondc
DATABASE_PASSWORD=ondc_secret
DATABASE_SCHEMA=opendata_nodata

# Redis (set REDIS_ENABLED=false to disable caching entirely)
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# MCP Server
TRANSPORT=stdio
MAX_QUERY_ROWS=1000
QUERY_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL=INFO
AUDIT_LOG_PATH=logs/audit.jsonl
